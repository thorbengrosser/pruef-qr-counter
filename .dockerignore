# Git
.git
.gitignore

# Environment (never bake secrets into image)
.env
.env.*
!.env.example

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyo
.venv/
venv/

# Data (mounted at runtime)
data/
*.db

# IDE / editor
.idea/
.vscode/

# Docs and planning (optional: remove to shrink image)
web-app/plans/

# Misc
*.md
!README.md
.DS_Store
