# Required in production
SERVER_SECRET=your-hmac-secret-at-least-32-chars
ADMIN_KEY=your-admin-key-for-reset-adjust

# Dashboard Basic Auth (Flask-level)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me

# Optional: load testing bypass. If set, POST /api/check with header X-Load-Test-Key: <value> skips rate limiting.
# LOAD_TEST_BYPASS_KEY=your-secret-load-test-key

# Optional: SQLite path. Use a path OUTSIDE the repo on remote machines so git pull
# never touches it. Docker default: /data/pruef.db (in named volume).
# DATABASE_PATH=/var/lib/pruef-qr/pruef.db

# Optional: port when running run.py directly
# PORT=5000
