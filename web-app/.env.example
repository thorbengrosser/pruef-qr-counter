# Required in production
SERVER_SECRET=your-hmac-secret-at-least-32-chars
ADMIN_KEY=your-admin-key-for-reset-adjust

# Dashboard Basic Auth (Flask-level)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me

# Optional: SQLite path (default /data/pruef.db for Docker volume)
# DATABASE_PATH=/data/pruef.db

# Optional: port when running run.py directly
# PORT=5000
